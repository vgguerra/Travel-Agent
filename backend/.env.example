# OpenWeatherMap API key (required for weather forecasts)
OPENWEATHER_API_KEY=your_openweathermap_key

# RapidAPI key & host for Booking.com / TripAdvisor (optional)
RAPID_KEY=your_rapidapi_key
RAPID_HOST=booking-com15.p.rapidapi.com

# LLM provider: ollama | google | openrouter
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-2.0-flash

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=arcee-ai/trinity-large-thinking:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PASSWORD=your-db-password
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key
